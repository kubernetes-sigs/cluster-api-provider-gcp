apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{.ClusterName}}-trigger
  namespace: default
spec:
  replicas: 1
  selector:
    matchLabels:
      app: autoscale-trigger
  template:
    metadata:
      labels:
        app: autoscale-trigger
    spec:
      schedulerName: default-scheduler
      containers:
      - name: pause
        image: registry.k8s.io/pause:3.10
        resources:
          requests:
            cpu: 100m
            memory: 128Mi
